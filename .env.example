# Skopiuj do .env i uzupełnij. Plik .env jest ignorowany przez git.
# Gradle czyta ADMOB_APP_ID_ANDROID, a aplikacja dostaje pozostałe wartości
# przez: flutter run --dart-define-from-file=.env
# Bez tych wartości używane są publiczne testowe identyfikatory Google.
ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
ADMOB_BANNER_ANDROID=ca-app-pub-3940256099942544/6300978111
ADMOB_BANNER_IOS=ca-app-pub-3940256099942544/2934735716
# Tylko dla buildów debug (testowanie formularza zgody UMP)
ADMOB_TEST_DEVICE_ID=
